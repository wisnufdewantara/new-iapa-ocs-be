generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model app_settings {
  setting_key   String    @id @db.VarChar(100)
  description   String?   @db.VarChar(500)
  label         String?   @db.VarChar(255)
  setting_value String?   @db.VarChar(255)
  updated_at    DateTime? @db.Timestamp(6)
}

// Hasil pengisian lembar UAT publik (/functional-test), aktif/nonaktif
// diatur admin (app_settings key 'functional_test.enabled'). test_id
// merujuk ke ID skenario tetap di FE (TC-01, dst), bukan FK ke tabel lain.
model functional_test_result {
  test_id    String   @id @db.VarChar(20)
  status     String   @default("pending") @db.VarChar(20)
  note       String?  @db.VarChar(500)
  tester     String?  @db.VarChar(100)
  updated_at DateTime @default(now()) @updatedAt
}

// Override subject/body email notifikasi (LoA, sertifikat, invoice).
// Kalau baris untuk satu template_key belum ada, FE/BE pakai default
// hardcode dari DEFAULT_EMAIL_TEMPLATES (lihat email-template.constant.ts)
// — baris di sini cuma dibuat begitu admin pertama kali nyimpen
// perubahan buat template itu.
model email_template {
  template_key String   @id @db.VarChar(50)
  label        String   @db.VarChar(255)
  subject      String   @db.VarChar(255)
  body_html    String
  updated_at   DateTime @default(now()) @updatedAt
}

// Catatan tiap percobaan kirim email keluar, dicatat TERPUSAT di
// MailerService.sendMail. Alasan ada: SMTP via nodemailer TIDAK nyimpen
// salinan ke folder "Sent" webmail pengirim (sekretariat@iapa.or.id),
// jadi tanpa tabel ini nggak ada cara mantau "email mana yang terkirim /
// gagal". Dipakai halaman "Mail Log Monitoring" di section Developer.
//
// status: 'sent' | 'failed'. error diisi cuma kalau failed.
// opened_at/open_count = tracking "read" lewat pixel, sifatnya BEST-EFFORT:
// banyak klien blok/preload gambar (Gmail proxy, Apple Mail Privacy
// Protection) jadi bisa false positive/negative — JANGAN dianggap pasti.
// Butuh env BACKEND_URL buat URL absolut pixel; kalau kosong, tracking
// read nonaktif tapi log sent/failed tetap jalan.
//
// Baris > 30 hari dihapus otomatis tiap hari (EmailLogCleanupService).
model email_log {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient   String    @db.VarChar(255)
  subject     String    @db.VarChar(255)
  type        String    @default("other") @db.VarChar(40)
  status      String    @db.VarChar(20)
  error       String?
  related_id  String?   @db.VarChar(255)
  track_token String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opened_at   DateTime? @db.Timestamp(6)
  open_count  Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  @@index([created_at])
  @@index([type])
  @@index([status])
}

model conference_settings {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conference_id String     @db.Uuid
  setting_key   String     @db.VarChar(100)
  setting_value String?    @db.VarChar(500)
  updated_at    DateTime?  @updatedAt @db.Timestamp(6)
  conference    conference @relation(fields: [conference_id], references: [conference_id], onDelete: Cascade)

  @@unique([conference_id, setting_key])
}

model audit_log {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(100)
  entity        String   @db.VarChar(100)
  entity_id     String?  @db.VarChar(255)
  detail        String?
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(100)
  is_system        Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  role_menu_items  role_menu_items[]
  role_permissions role_permissions[]
}

model role_menu_items {
  role_id  String @db.Uuid
  menu_key String @db.VarChar(255)
  roles    roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, menu_key])
}

model role_permissions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id    String   @db.Uuid
  module     String   @db.VarChar(100)
  action     String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, module, action])
}

model attendance {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_id          String?        @db.Uuid
  writer_id         String?        @db.Uuid
  presence          Boolean        @default(false)
  sent_ecertificate Boolean        @default(false)
  certificate_url   String?        @db.VarChar(255)
  participant_id    String?        @db.Uuid
  conference_id     String?        @db.Uuid
  papers            papers?        @relation(fields: [paper_id], references: [paper_id], onDelete: Cascade, onUpdate: NoAction)
  paper_writers     paper_writers? @relation(fields: [writer_id], references: [writer_id], onDelete: Cascade, onUpdate: NoAction)
  participant       participant?   @relation(fields: [participant_id], references: [attendance_id], onDelete: NoAction, onUpdate: NoAction, map: "fk8e0qxhwb9cqx14glphxbghwmc")
  conference        conference?    @relation(fields: [conference_id], references: [conference_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_to_conference")
  issued_certificates issued_certificates[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model conference {
  conference_id                           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conference_name                         String                 @unique @db.VarChar(255)
  conference_date                         DateTime               @db.Date
  created_at                              DateTime               @default(now()) @db.Timestamp(6)
  best_paper                              String?                @db.Uuid
  best_presenter                          String?                @db.Uuid
  paper_certificate_sent                  Boolean                @default(false)
  presenter_certificate_sent              Boolean                @default(false)
  conference_end_date                     DateTime?              @db.Date
  status                                  String                 @default("coming_soon") @db.VarChar(20)
  attendance                              attendance[]
  conference_settings                     conference_settings[]
  conference_posters                      conference_posters[]
  papers_conference_best_paperTopapers    papers?                @relation("conference_best_paperTopapers", fields: [best_paper], references: [paper_id], onDelete: NoAction, onUpdate: NoAction)
  paper_writers                           paper_writers?         @relation(fields: [best_presenter], references: [writer_id], onDelete: NoAction, onUpdate: NoAction)
  conference_sub_theme                    conference_sub_theme[]
  paper_reviewer                          paper_reviewer[]
  papers_papers_conference_idToconference papers[]               @relation("papers_conference_idToconference")
  participant                             participant[]
  schedule                                schedule[]
  sessions                                sessions[]
  conference_certificate_templates        conference_certificate_templates[]
  issued_certificates                     issued_certificates[]
}

model conference_posters {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conference_id String     @db.Uuid
  image_url     String     @db.VarChar(500)
  sort_order    Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  conference    conference @relation(fields: [conference_id], references: [conference_id], onDelete: Cascade)
}

model conference_sub_theme {
  conference_id String     @db.Uuid
  sub_theme     String?    @db.VarChar(255)
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conference    conference @relation(fields: [conference_id], references: [conference_id], onDelete: NoAction, onUpdate: NoAction)
}

model invoices {
  invoice_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id    String        @db.Uuid
  nomor_invoice String        @db.VarChar(255)
  payment_date  DateTime      @default(now()) @db.Timestamp(6)
  payment_from  String        @db.Uuid
  nominal       String        @db.VarChar(255)
  description   String?       @db.VarChar(255)
  paper_writers paper_writers @relation(fields: [payment_from], references: [writer_id], onDelete: Cascade, onUpdate: NoAction)
  payments      payments      @relation(fields: [payment_id], references: [payment_id], onDelete: Cascade, onUpdate: NoAction)
}

model paper_reviewer {
  review_id                                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_id                                 String      @db.Uuid
  reviewer_id                              String      @db.Uuid
  submitter_id                             String      @db.Uuid
  paper_title                              String      @db.VarChar(255)
  writer_name                              String      @db.VarChar(255)
  reviewed_paper_url                       String?
  assigned_date                            DateTime?   @default(now()) @db.Timestamp(6)
  deadline                                 DateTime    @db.Date
  accepted                                 Boolean?
  manager_id                               String?     @db.Uuid
  conference_id                            String?     @db.Uuid
  users_paper_reviewer_manager_idTousers   users?      @relation("paper_reviewer_manager_idTousers", fields: [manager_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fkhf7u9lsxr9lut0flpvsjmor5i")
  conference                               conference? @relation(fields: [conference_id], references: [conference_id], onDelete: Cascade, onUpdate: NoAction)
  papers                                   papers      @relation(fields: [paper_id], references: [paper_id], onDelete: Cascade, onUpdate: NoAction)
  users_paper_reviewer_reviewer_idTousers  users       @relation("paper_reviewer_reviewer_idTousers", fields: [reviewer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  users_paper_reviewer_submitter_idTousers users       @relation("paper_reviewer_submitter_idTousers", fields: [submitter_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([paper_id, reviewer_id], map: "uk117pbrqqapwelkxpb74glwi32")
  @@unique([paper_id, reviewer_id], map: "unique_paper_reviewer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model paper_writers {
  writer_id       String           @id @db.Uuid
  paper_id        String           @db.Uuid
  first_name      String           @db.VarChar(255)
  role            String?          @db.VarChar(50)
  // Urutan penulis sesuai submission (0 = penulis pertama). Kolom BARU
  // (2026-09-15) — baris lama default 0, jadi urutannya di antara
  // mereka sendiri nggak berubah dari perilaku lama; submission baru
  // ke depannya selalu diisi eksplisit dari index array authors.
  writer_order    Int?             @default(0)
  last_name       String           @default("") @db.VarChar(255)
  gender          String           @db.VarChar(10)
  affiliation     String           @db.VarChar(255)
  email           String           @db.VarChar(255)
  phone_number    String?          @db.VarChar(20)
  member_status   Boolean?         @default(false)
  certificate_url String?          @db.VarChar(255)
  // null = normal (ikut aturan member/non-member biasa). "non_payment"/"writer"
  // = admin sengaja tandain baris ini gak bayar sama sekali (fee dipaksa 0).
  // Kolom BARU (2026-09-20), mirror dari CMS-IAPA-BE paper_writers.payment_override.
  payment_override String?         @db.VarChar(20)
  // Fee custom yang di-set ADMIN MANUAL buat writer ini (biasanya
  // non-submitter yang sengaja minta ikut bayar sendiri demi dapat
  // sertifikat sendiri — kasus "presenter kelompok" di luar aturan
  // submitter-only biasa). SEKALI diisi (non-null), backend nolak
  // perubahan lagi — sengaja gak bisa direvisi, biar gak disalahgunakan
  // bolak-balik. Kolom BARU (2026-09-21).
  manual_fee      Decimal?         @db.Decimal(10, 2)
  user_id         String?          @db.Uuid
  attendance      attendance[]
  conference      conference[]
  invoices        invoices[]
  users           users?           @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fkg55k8aa56g9ygbgj9dftkw14j")
  papers          papers           @relation(fields: [paper_id], references: [paper_id], onDelete: Cascade, onUpdate: NoAction)
  payment_proofs  payment_proofs[]
}

model papers {
  paper_id                                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_title                                 String           @db.VarChar(255)
  submitter_id                                String?          @db.Uuid
  upload_date                                 DateTime?        @default(now()) @db.Timestamp(6)
  // Diisi SATU tempat: PapersService.updateStatus() saat conference_status
  // berubah jadi 'Accepted' (null lagi kalau Waiting/Rejected). Dipakai
  // halaman validasi sertifikat publik sebagai "tanggal lolos paper" —
  // kalau null (paper lama / disync dari ocs2), fallback ke conference_date.
  accepted_at                                 DateTime?        @db.Timestamp(6)
  document_url                                String?
  paper_status                                String           @db.VarChar(255)
  conference_status                           String?          @db.VarChar(255)
  sent_loa                                    Boolean          @default(false)
  conference_id                               String?          @db.Uuid
  sent_confirmation                           Boolean?         @default(false)
  feedback_url                                String?
  review_feedback                             String?
  type                                        String?          @db.VarChar(255)
  keywords                                    String?
  sub_theme                                   String?          @db.VarChar(255)
  abstract_text                               String?
  attendance                                  attendance[]
  conference_conference_best_paperTopapers    conference[]     @relation("conference_best_paperTopapers")
  paper_reviewer                              paper_reviewer[]
  paper_writers                               paper_writers[]
  conference_papers_conference_idToconference conference?      @relation("papers_conference_idToconference", fields: [conference_id], references: [conference_id], onDelete: Cascade, onUpdate: NoAction)
  users                                       users?           @relation(fields: [submitter_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  payments                                    payments[]
  schedule                                    schedule[]
}

model participant {
  attendance_id         String       @id @db.Uuid
  description           String?      @db.VarChar(255)
  link_payment_upload   String?      @db.VarChar(255)
  payment_status        String?      @db.VarChar(255)
  sent_invoice          Boolean?
  sent_price            Boolean?
  total_amount          BigInt?
  is_member             Boolean?
  role                  String?      @db.VarChar(255)
  conference_id         String?      @db.Uuid
  payment_sender_name   String?      @db.VarChar(255)
  payment_transfer_date String?      @db.VarChar(255)
  attendance            attendance[]
  conference            conference?  @relation(fields: [conference_id], references: [conference_id], onDelete: NoAction, onUpdate: NoAction, map: "fkgosru3n5mafb2b3spcy2saebx")
  users                 users        @relation(fields: [attendance_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model payment_proofs {
  proof_id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id    String         @db.Uuid
  writer_id     String?        @db.Uuid
  proof_url     String         @db.VarChar(255)
  upload_date   DateTime?      @default(now()) @db.Timestamp(6)
  sender_name   String?        @db.VarChar(255)
  transfer_date String?        @db.VarChar(255)
  payments      payments       @relation(fields: [payment_id], references: [payment_id], onDelete: Cascade, onUpdate: NoAction)
  paper_writers paper_writers? @relation(fields: [writer_id], references: [writer_id], onUpdate: NoAction)
}

model payment_types {
  payment_type_id String    @id @db.Uuid
  builtin         Boolean
  label           String    @db.VarChar(255)
  type_key        String    @unique(map: "ukfacn33mtbkvjkkpv5rglm8o8g") @db.VarChar(100)
  unique_code     String?   @db.VarChar(3)
  updated_at      DateTime? @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  payment_id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_id       String?          @db.Uuid
  submitter_id   String           @db.Uuid
  total_amount   Decimal?         @db.Decimal(10, 2)
  payment_status String?          @default("'waiting for calculation'::character varying") @db.VarChar(255)
  due_date       DateTime?        @default(now()) @db.Timestamp(6)
  sent_invoice   Boolean          @default(false)
  payment_type   String           @default("team") @db.VarChar(255)
  description    String?          @db.VarChar(255)
  sent_price     Boolean?         @default(false)
  invoices       invoices[]
  payment_proofs payment_proofs[]
  papers         papers?          @relation(fields: [paper_id], references: [paper_id], onDelete: Cascade, onUpdate: NoAction)
  users          users            @relation(fields: [submitter_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  // Ditambah manual via psql 2026-09-30 (bareng ganti trigger create_payment_on_acceptance
  // ke ON CONFLICT DO NOTHING) — nutup race condition yang bikin 1 paper bisa
  // punya 2 baris payment. Dideklarasi di sini juga biar `prisma db push`
  // nggak nyoba nge-drop constraint yang udah ada di database.
  @@unique([paper_id], map: "payments_paper_id_unique")
}

model schedule {
  schedule_id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_id        String     @db.Uuid
  presenter_name  String     @db.VarChar(255)
  schedule_date   DateTime   @db.Date
  schedule_time   DateTime   @db.Time(6)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  conference_id   String     @db.Uuid
  presenter_email String?    @db.VarChar(255)
  room            String?    @db.VarChar(255)
  session_name    String?    @db.VarChar(255)
  type            String?    @db.VarChar(255)
  session_id      String?    @db.Uuid
  sent            Boolean?
  conference      conference @relation(fields: [conference_id], references: [conference_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_schedule_conference")
  sessions        sessions?  @relation(fields: [session_id], references: [session_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_schedule_session")
  papers          papers     @relation(fields: [paper_id], references: [paper_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sessions {
  session_id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conference_id String     @db.Uuid
  session_name  String     @db.VarChar(255)
  session_date  DateTime?  @db.Date
  type          String     @db.VarChar(255)
  room          String?    @db.VarChar(255)
  created_at    DateTime   @db.Timestamp(6)
  schedule      schedule[]
  conference    conference @relation(fields: [conference_id], references: [conference_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sessions_conference")

  @@unique([conference_id, session_name, session_date, type], map: "sessions_unique")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id                                           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                                          String           @unique @db.VarChar(255)
  password                                          String
  first_name                                        String           @db.VarChar(255)
  last_name                                         String           @db.VarChar(255)
  gender                                            String           @db.VarChar(255)
  affiliation                                       String           @db.VarChar(255)
  email                                             String           @unique @db.VarChar(255)
  phone                                             String           @db.VarChar(255)
  country                                           String?          @db.VarChar(255)
  created_at                                        DateTime?        @default(now()) @db.Timestamp(6)
  role                                              String           @default("Peserta") @db.VarChar(255)
  hash_algorithm                                    String?          @default("bcrypt") @db.VarChar(255)
  photo_url                                         String?
  paper_reviewer_paper_reviewer_manager_idTousers   paper_reviewer[] @relation("paper_reviewer_manager_idTousers")
  paper_reviewer_paper_reviewer_reviewer_idTousers  paper_reviewer[] @relation("paper_reviewer_reviewer_idTousers")
  paper_reviewer_paper_reviewer_submitter_idTousers paper_reviewer[] @relation("paper_reviewer_submitter_idTousers")
  paper_writers                                     paper_writers[]
  papers                                            papers[]
  participant                                       participant?
  payments                                          payments[]
  password_reset_tokens                             password_reset_tokens[]
}

// Kolom ini SENGAJA nggak ada di Supabase (users di-sync dari sana) —
// aman, sync cuma nulis kolom yang ADA di hasil SELECT Supabase, jadi
// nggak akan kesentuh/ke-reset sync. Token sekali pakai, expire manual
// dicek di service (bukan lewat TTL Postgres), 1 jam dari saat dibuat.
model password_reset_tokens {
  token      String    @id @db.VarChar(64)
  user_id    String    @db.Uuid
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

// Sistem manajemen sertifikat baru (per-template, configurable) —
// berdampingan sama generator lama yang hardcoded di certificate.service.ts
// (dipakai sebagai fallback kalau conference belum dikonfigurasi lewat
// sistem baru ini). Semua posisi/ukuran disimpan sebagai FRAKSI 0..1 dari
// lebar(x)/tinggi(y) HALAMAN PDF, menandai TITIK TENGAH elemen — generalisasi
// dari pola REF_H yang sudah ada di certificate.service.ts, dan bikin posisi
// di editor (persentase dari gambar desain yang dirender) match 1:1 ke posisi
// render PDF (karena gambar desain = ukuran halaman PDF, aspect ratio sama).
model certificate_templates {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  description      String?  @db.VarChar(500)
  design_image_url String   @db.VarChar(500)
  design_width_px  Int
  design_height_px Int
  // Dipakai kalau conference belum di-mapping eksplisit lewat
  // conference_certificate_templates — paling banyak SATU baris boleh true,
  // dijaga di service lewat transaction, bukan DB constraint.
  is_default       Boolean  @default(false)
  // Nama Penerima & Label Tipe BUKAN field khusus lagi — sekarang baris
  // biasa di certificate_template_placeholders (type='name'/'cert_type'),
  // bisa diatur posisi/font/dihapus sama kayak placeholder custom
  // (keputusan user, migrasi data lama ada di migrate_name_label.cjs
  // yang udah dijalanin manual, lihat SESSION_NOTES.md).
  // Dipakai buat nama+jabatan penandatangan (fase 2) dan halaman 2 (fase 3).
  body_font_key    String   @default("cardo_regular") @db.VarChar(50)
  signer_font_size Float    @default(0.022)
  signer_color     String   @default("#17366A") @db.VarChar(7)
  // Halaman kedua: free-text (format baris "- "/"* " = bullet) + total JP.
  // Isinya SAMA buat semua penerima dalam satu template (keputusan user).
  page2_enabled    Boolean  @default(false)
  page2_title      String?  @db.VarChar(255)
  page2_content    String?
  page2_total_jp   Int?
  page2_font_size  Float    @default(0.022)
  qr_enabled       Boolean  @default(false)
  qr_pos_x         Float    @default(0.9)
  qr_pos_y         Float    @default(0.85)
  qr_size          Float    @default(0.09)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamp(6)
  conference_certificate_templates conference_certificate_templates[]
  certificate_template_signers     certificate_template_signers[]
  certificate_template_placeholders certificate_template_placeholders[]
  issued_certificates              issued_certificates[]
}

// Pemetaan: template mana dipakai buat tipe sertifikat (participant/
// presenter/best_paper/best_presenter) di satu conference. Kalau nggak ada
// baris buat kombinasi tertentu, resolveTemplate() fallback ke template
// is_default=true, lalu ke generator hardcoded lama kalau itu pun nggak ada.
model conference_certificate_templates {
  conference_id String   @db.Uuid
  cert_type     String   @db.VarChar(30)
  template_id   String   @db.Uuid
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(6)
  conference            conference            @relation(fields: [conference_id], references: [conference_id], onDelete: Cascade)
  certificate_templates certificate_templates @relation(fields: [template_id], references: [id], onDelete: Restrict)
  @@id([conference_id, cert_type])
}

// Sampai 3 slot penanda tangan per template. signature_image_url nullable
// (boleh cuma nama+jabatan tanpa gambar ttd).
model certificate_template_signers {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id         String   @db.Uuid
  slot                Int
  signer_name         String   @db.VarChar(255)
  signer_title        String?  @db.VarChar(255)
  signature_image_url String?  @db.VarChar(500)
  signature_width_px  Int?
  signature_height_px Int?
  pos_x               Float    @default(0.5)
  pos_y               Float    @default(0.78)
  width               Float    @default(0.15)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp(6)
  certificate_templates certificate_templates @relation(fields: [template_id], references: [id], onDelete: Cascade)
  @@unique([template_id, slot])
}

// Sampai 10 slot teks manual tambahan per template (di luar Nama Penerima
// & Label yang udah ada field khususnya) — buat nama acara, kalimat
// partisipasi, dll. `content` boleh teks polos atau diselingi
// {{variabel}} (lihat CERTIFICATE_PLACEHOLDER_VARIABLES di
// certificate-placeholder-variables.constant.ts), diinterpolasi sama
// persis saat render & SAMA buat semua penerima dalam satu template
// (nggak ada input per-orang) — variabel kayak {{name}} cuma buat
// ngulang nama penerima di tempat lain kalau perlu, bukan per-penerima.
model certificate_template_placeholders {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id String  @db.Uuid
  slot       Int
  // 'name' | 'cert_type' | 'custom' — name & cert_type ngerender otomatis
  // dari data recipient (content-nya diabaikan, diisi string kosong),
  // custom ngerender dari content (boleh ada {{variabel}}). Ini yang bikin
  // Nama Penerima & Label Tipe nggak lagi field khusus di certificate_templates
  // — jadi baris biasa di tabel ini, bisa diatur posisi/font/dihapus sama
  // kayak placeholder custom.
  type       String   @default("custom") @db.VarChar(20)
  content    String   @db.VarChar(500)
  font_key   String   @default("cardo_regular") @db.VarChar(50)
  font_size  Float    @default(0.025)
  color      String   @default("#17366A") @db.VarChar(7)
  pos_x      Float    @default(0.5)
  pos_y      Float    @default(0.6)
  max_width  Float    @default(0.6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  certificate_templates certificate_templates @relation(fields: [template_id], references: [id], onDelete: Cascade)
  @@unique([template_id, slot])
}

// Snapshot SEMPIT tiap sertifikat yang pernah digenerate lewat sistem
// template baru (dibuat/diupdate idempotent via dedupe_key saat renderFor()
// dipanggil, BUKAN tiap download) — satu-satunya sumber data buat endpoint
// publik /api/certificate-validation, SENGAJA nggak pernah join ke
// users/papers live biar permukaan data yang bisa bocor dibatasi ketat.
// verification_code kolom terpisah dari id (PK) biar bisa dirotate tanpa
// ganti FK kalau suatu saat perlu.
model issued_certificates {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verification_code String   @unique @db.VarChar(64)
  // Dedup key: "att:{attendanceId}:{certType}" buat participant/presenter,
  // "award:{conferenceId}:{certType}:{writerId}" buat award (writerId
  // penting — kalau best_paper diganti, QR pemenang lama tetap nunjuk ke
  // data pemenang lama, bukan ketiban data pemenang baru).
  dedupe_key        String   @unique @db.VarChar(200)
  cert_type         String   @db.VarChar(30)
  recipient_name    String   @db.VarChar(255)
  event_title       String   @db.VarChar(500)
  conference_name   String   @db.VarChar(255)
  event_date        DateTime @db.Date
  event_date_source String   @db.VarChar(30)
  conference_id     String?  @db.Uuid
  attendance_id     String?  @db.Uuid
  writer_id         String?  @db.Uuid
  template_id       String?  @db.Uuid
  is_revoked        Boolean  @default(false)
  issued_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(6)
  conference            conference?            @relation(fields: [conference_id], references: [conference_id], onDelete: SetNull)
  attendance            attendance?            @relation(fields: [attendance_id], references: [id], onDelete: SetNull)
  certificate_templates certificate_templates? @relation(fields: [template_id], references: [id], onDelete: SetNull)
}

enum conference_status_enum {
  Waiting
  Accepted
  Rejected
}

enum paper_status_enum {
  Unassigned
  Assigned
  Accepted
  Rejected
}
